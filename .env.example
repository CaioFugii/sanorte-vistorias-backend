# Local database (docker compose from the monorepo root)
DATABASE_URL=postgres://sanorte:sanorte@localhost:5432/vistorias_db
DATABASE_SSL=false

# Optional discrete fields if DATABASE_URL is omitted
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=sanorte
# DB_PASSWORD=sanorte
# DB_DATABASE=vistorias_db

PORT=3000
NODE_ENV=development
PUBLIC_API_URL=http://localhost:3000

JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h
CORS_ORIGINS=http://localhost:5173
AUTH_LOGIN_THROTTLE_LIMIT=5
AUTH_LOGIN_THROTTLE_TTL_MS=60000

UPLOAD_MAX_SIZE=5242880
STORAGE_PATH=./storage

# Storage provider: local | cloudinary | s3
STORAGE_PROVIDER=local

CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

AWS_REGION=sa-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Optional custom public base URL (e.g. CloudFront)
# AWS_S3_PUBLIC_BASE_URL=https://d123.cloudfront.net
